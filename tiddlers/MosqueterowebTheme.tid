title: MosqueterowebTheme
tags: $:/tags/Stylesheet

/* Tema Mosqueteroweb — paleta verde de Pedro */
:root {
  --tc-page-background: #f3f6f4;
  --tc-sidebar-background: #e7eee9;
  --tc-sidebar-border: #d8e3db;
  --tc-tiddler-background: #ffffff;
  --tc-tiddler-border: #d8e3db;
  --tc-foreground: #2f3e36;
  --tc-muted-foreground: #6b7d72;
  --tc-accent-color: #5a8a6b;
  --tc-background: #f3f6f4;
  --tc-highlight: #5a8a6b;
}

html body.tc-body {
  background: #f3f6f4;
  color: #2f3e36;
  font-family: -apple-system, system-ui, "Segoe UI", Roboto, sans-serif;
}

.tc-sidebar-scrollable {
  background: #e7eee9;
}

.tc-tiddler-frame {
  background: #ffffff;
  border: 1px solid #d8e3db;
  border-radius: 12px;
  box-shadow: 0 2px 10px rgba(47,62,54,.06);
}

.tc-tiddler-title {
  color: #2f3e36;
  font-family: Georgia, "Times New Roman", serif;
}

/* Etiquetas separadas */
.tc-tag-list-item {
  display: inline-block;
  margin: 0 0.4em 0.4em 0;
}
.tc-tag-label {
  display: inline-block;
  padding: 0.22em 0.65em;
  background: #e7eee9;
  color: #5a8a6b;
  border-radius: 6px;
  font-size: 0.78em;
  white-space: nowrap;
}

.tc-tab-buttons button.tc-tab-selected {
  border-bottom: 2px solid #5a8a6b;
}

/* Vídeos adaptados a su resolución nativa (no full-width) */
.tc-body video {
  max-width: 100%;
  max-height: 70vh;
  width: auto;
  height: auto;
  display: block;
  margin: 0.5em 0;
  border-radius: 10px;
  background: #000;
}
.tc-body iframe {
  max-width: 100%;
  border-radius: 8px;
}
.tc-body img {
  max-width: 100%;
  height: auto;
}

/* ===== Vista solo lectura: ocultar edición/gestión ===== */
.tc-page-controls { display: none !important; }
.tc-tiddler-controls { display: none !important; }
.tc-sidebar-tabs { display: none !important; }

/* ===== Dos columnas fijas: sidebar lateral siempre visible ===== */
.tc-topbar { display: none !important; }

.tc-page-container-inner {
  display: flex !important;
  align-items: stretch !important;
}

.tc-sidebar-scrollable {
  display: block !important;
  position: static !important;
  top: auto !important;
  left: auto !important;
  right: auto !important;
  bottom: auto !important;
  inset: auto !important;
  margin: 0 !important;
  flex: 0 0 280px !important;
  width: 280px !important;
  min-width: 280px !important;
  height: 100vh !important;
  overflow-y: auto !important;
  padding: 24px 16px !important;
  box-sizing: border-box;
}

.tc-story-river {
  flex: 1 1 auto !important;
  position: static !important;
  left: auto !important;
  top: auto !important;
  width: auto !important;
  max-width: 840px !important;
  margin: 0 auto !important;
  padding: 28px 24px !important;
  box-sizing: border-box;
}
